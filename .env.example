# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://tutor:tutor_password@localhost:5432/tutor

# WhatsApp (Meta Business Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
WHATSAPP_VERIFY_TOKEN=any_random_string_you_pick
WHATSAPP_APP_SECRET=your_app_secret_for_signature_verification

# LLM — Groq (primary, OpenAI-compatible, fast, cheap)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Embeddings — "local" runs free on this server, no API key needed, never quota-limited.
EMBEDDING_PROVIDER=local

# --- Optional / legacy providers. Leave blank, the app runs fine without them. ---
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Tutor default persona
DEFAULT_TUTOR_NAME=Wax
DEFAULT_TUTOR_FORMALITY=casual

# Safety
DISTRESS_HELPLINE_NIGERIA=Nigeria Suicide Prevention Initiative: 0800-DEPRESSION (0800-337-3773)
