# ═══════════════════════════════════════════════════════════════
# WAXPREP AI TUTOR — Environment Variables
# ═══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────────
# Meta WhatsApp Business API Configuration
# ───────────────────────────────────────────────────────────────
META_APP_SECRET=your_meta_app_secret_here
META_VERIFY_TOKEN=your_verify_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_ACCESS_TOKEN=your_access_token_here

# ───────────────────────────────────────────────────────────────
# Redis Configuration
# ───────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ───────────────────────────────────────────────────────────────
# Supabase Configuration
# ───────────────────────────────────────────────────────────────
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ───────────────────────────────────────────────────────────────
# Server Configuration
# ───────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ───────────────────────────────────────────────────────────────
# Queue Configuration
# ───────────────────────────────────────────────────────────────
QUEUE_PREFIX=waxprep
QUEUE_CONCURRENCY=10
QUEUE_MAX_RETRIES=3

# ───────────────────────────────────────────────────────────────
# Webhook Configuration
# ───────────────────────────────────────────────────────────────
WEBHOOK_TIMEOUT_MS=80
WEBHOOK_MAX_BODY_SIZE=1048576
SECURITY_SIGNATURE_HEADER=x-hub-signature-256

# ───────────────────────────────────────────────────────────────
# ═══════ NEW: CUGA AI Brain Configuration ═══════
# ───────────────────────────────────────────────────────────────

# CUGA Service URL (Python FastAPI service)
CUGA_SERVICE_URL=http://localhost:8000
CUGA_API_KEY=generate_a_random_secret_key_here

# ───────────────────────────────────────────────────────────────
# ═══════ NEW: Modal.com Model Configuration ═══════
# ───────────────────────────────────────────────────────────────

# Modal endpoint URL (from `modal deploy` output)
MODAL_ENDPOINT=https://your-username--waxprep-tutor-model-fastapi-app.modal.run
MODAL_TOKEN=your_modal_token_here

# Get your Modal token:
# 1. pip install modal
# 2. modal token new
# 3. Copy the token ID and secret

# ───────────────────────────────────────────────────────────────
# Logging
# ───────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ───────────────────────────────────────────────────────────────
# OpenRouter Fallback (optional — for redundancy)
# ───────────────────────────────────────────────────────────────
# If Modal is unavailable, fall back to OpenRouter free tier
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct  # Free tier model

# ───────────────────────────────────────────────────────────────
# Feature Flags
# ───────────────────────────────────────────────────────────────
ENABLE_CUGA=true
ENABLE_STREAMING=false
ENABLE_MEMORY_BRIDGE=true
ENABLE_COMPLEXITY_ANALYSIS=true
